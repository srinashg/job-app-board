# --- General ---
ENVIRONMENT=development
PROJECT_NAME="Job Application Board"

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobboard

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-every-environment
# Fernet key used to encrypt personal data at rest. Required in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- OAuth 2.0 (optional; password sign-in works without it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
RESUME_STORAGE_DIR=./var/resumes
MAX_RESUME_BYTES=5242880

# --- Recommendations ---
BATCH_SIZE=5
JOB_STALE_AFTER_DAYS=21
JOB_RECHECK_AFTER_HOURS=24

# --- Ingestion ---
# Turn on to verify listings with a real browser instead of an HTTP check.
PLAYWRIGHT_ENABLED=false
INGEST_REQUEST_TIMEOUT=20
